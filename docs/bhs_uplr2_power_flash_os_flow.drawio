        <mxCell id="analysis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Analyze saved logs and command outputs&#xa;Report FLASH_OK, FLOW_OK, COM3/COM4 bytes, CPU, memory, IP" vertex="1">
