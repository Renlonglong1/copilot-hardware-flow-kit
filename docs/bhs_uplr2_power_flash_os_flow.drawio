        <mxCell id="end" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" value="End&#xa;FLOW_OK=True when flash, boot, and OS interaction pass" vertex="1">
