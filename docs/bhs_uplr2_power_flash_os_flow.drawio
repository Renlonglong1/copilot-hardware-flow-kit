<mxfile host="Electron" agent="Copilot CLI">
  <diagram id="bhs-uplr2-flow-v2" name="BHS uPLR2 Robust Flow">
    <mxGraphModel dx="1414" dy="841" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="2300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;" value="BHS uPLR2 Robust Flow: Power Off - Flash - Boot - OS Interaction" vertex="1">
          <mxGeometry height="40" width="1040" x="80" y="20" as="geometry" />
        </mxCell>
        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" value="Start&#xa;Input: server, BIN path, chip, capture time" vertex="1">
          <mxGeometry height="70" width="360" x="420" y="90" as="geometry" />
        </mxCell>
        <mxCell id="precheck" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Precheck&#xa;SSH reachable&#xa;BIN exists and SHA256 saved&#xa;DediProg USB present&#xa;smucmd and PowerSplitterCL exist&#xa;COM3 and COM4 present" vertex="1">
          <mxGeometry height="130" width="440" x="380" y="200" as="geometry" />
        </mxCell>
        <mxCell id="gui" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="EM100.exe or Emulator.exe running?" vertex="1">
          <mxGeometry height="110" width="330" x="435" y="370" as="geometry" />
        </mxCell>
        <mxCell id="closeGui" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Close GUI conflict&#xa;Then rerun smucmd check" vertex="1">
          <mxGeometry height="80" width="280" x="850" y="385" as="geometry" />
        </mxCell>
        <mxCell id="visible" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="smucmd sees EM100?&#xa;Expected: Device 1 (EM143479)" vertex="1">
          <mxGeometry height="120" width="330" x="435" y="530" as="geometry" />
        </mxCell>
        <mxCell id="abortDevice" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" value="Abort before hardware action&#xa;Report USB, process, smucmd state" vertex="1">
          <mxGeometry height="80" width="280" x="80" y="550" as="geometry" />
        </mxCell>
        <mxCell id="stop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="smucmd --stop&#xa;Move EM100 to STOP mode" vertex="1">
          <mxGeometry height="80" width="440" x="380" y="690" as="geometry" />
        </mxCell>
        <mxCell id="off" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="PowerSplitter poweroff&#xa;Turn all power outputs off" vertex="1">
          <mxGeometry height="80" width="440" x="380" y="810" as="geometry" />
        </mxCell>
        <mxCell id="flash" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Flash EM100&#xa;smucmd --stop --set MX66U1G45G -d &lt;bin&gt; -v --start" vertex="1">
          <mxGeometry height="90" width="440" x="380" y="930" as="geometry" />
        </mxCell>
        <mxCell id="flashOk" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="FLASH_OK?&#xa;Required:&#xa;Download Complete&#xa;Verify Pass&#xa;Emulation mode&#xa;Authentication Pass" vertex="1">
          <mxGeometry height="150" width="360" x="420" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="diag" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Diagnose flash failure immediately&#xa;Do not start serial capture&#xa;Check GUI conflict, USB, smucmd output" vertex="1">
          <mxGeometry height="100" width="300" x="850" y="1085" as="geometry" />
        </mxCell>
        <mxCell id="rec" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Recoverable?&#xa;Example: GUI conflict caused No device is connected" vertex="1">
          <mxGeometry height="120" width="270" x="865" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="retry" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Recover and retry flash&#xa;Max 1-2 retries" vertex="1">
          <mxGeometry height="80" width="300" x="850" y="1410" as="geometry" />
        </mxCell>
        <mxCell id="abortFlash" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" value="Terminate flow&#xa;Report failure reason and logs&#xa;No power-on, no serial wait" vertex="1">
          <mxGeometry height="90" width="300" x="850" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="openSerial" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Open serial ports before power-on&#xa;COM3 = GNR CPU&#xa;COM4 = BMC&#xa;115200 8N1" vertex="1">
          <mxGeometry height="100" width="440" x="380" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="denied" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="COM3 or COM4 access denied?" vertex="1">
          <mxGeometry height="110" width="330" x="435" y="1410" as="geometry" />
        </mxCell>
        <mxCell id="serialDiag" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Diagnose serial conflict&#xa;Close terminal tools or retry after handle release&#xa;Do not power on until COM ports open" vertex="1">
          <mxGeometry height="100" width="300" x="80" y="1415" as="geometry" />
        </mxCell>
        <mxCell id="on" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" value="PowerSplitter poweron&#xa;Start board boot" vertex="1">
          <mxGeometry height="80" width="440" x="380" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="capture" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Save full raw logs first&#xa;COM3_GNR_CPU_full_10m.log&#xa;COM4_BMC_full_10m.log&#xa;Duration: about 10 minutes" vertex="1">
          <mxGeometry height="110" width="440" x="380" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="prompt" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="COM3 reaches OS login?&#xa;Expected: gnr-bkc login:" vertex="1">
          <mxGeometry height="120" width="330" x="435" y="1840" as="geometry" />
        </mxCell>
        <mxCell id="bootFail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Report boot issue&#xa;Keep full COM3 and COM4 logs" vertex="1">
