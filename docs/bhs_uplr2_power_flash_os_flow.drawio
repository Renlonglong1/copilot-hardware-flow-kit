        <mxCell id="cmds" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" value="Run OS validation commands&#xa;lscpu&#xa;lsmem&#xa;ip addr" vertex="1">
